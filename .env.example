# NUMORA Space Global Environment Example (v1.7)
# Copy to individual backend/.env and frontend/.env as required

# --- Frontend Configuration (Vite Safe) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Backend Configuration (FastAPI - Strictly Confidential) ---
APP_NAME="NUMORA Space API"
APP_VERSION=0.2.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Supabase Server Integration (NEVER EXPOSE SERVICE ROLE KEY TO CLIENT)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-backend-service-role-key-here
# SUPABASE_JWT_SECRET=your-jwt-verification-secret-here

# AI Engine Settings
# GEMINI_API_KEY=
# OPENAI_API_KEY=
DEFAULT_AI_MODEL=gemini-1.5-flash
