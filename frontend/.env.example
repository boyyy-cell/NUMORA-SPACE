# ===================================================================
# NUMORA SPACE FRONTEND — ENVIRONMENT CONFIGURATION
# ===================================================================

# 1. Backend FastAPI Service Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000

# 2. Public Google OAuth 2.0 Web Client ID for Google Identity Services
# Use the same Web Client ID as backend/.env (GOOGLE_CLIENT_ID).
# Add each local frontend origin to Authorized JavaScript origins in Google Cloud:
#   http://localhost:5174
#   http://127.0.0.1:5174
# GIS popup credential flow does not require an Authorized Redirect URI.
# Never put a Google Client Secret in frontend environment files.
# VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
