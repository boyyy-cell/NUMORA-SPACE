APP_NAME="NUMORA Space API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
HOST="127.0.0.1"
PORT=8000
JWT_SECRET_KEY=
JWT_ALGORITHM="HS256"
# Must match frontend/.env VITE_GOOGLE_CLIENT_ID (OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=
# Optional: set to a persistent local path; SQLite does not support ephemeral/multi-instance durability.
# NUMORA_SECURITY_DB_PATH=
# Only set explicit proxy IPs/CIDRs when the backend is actually behind those proxies.
# TRUSTED_PROXIES=[]

